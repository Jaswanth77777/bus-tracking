# Copy this file to .env for LOCAL development only.
# Generate a unique long random secret. Never commit your real .env file.
JOY_BUS_SECRET=replace-with-a-long-random-secret

# Local HTTP development must use 0 so browser session cookies are sent.
# Set SESSION_COOKIE_SECURE=1 in Vercel/production HTTPS environment variables.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Optional settings
GPS_TIMEOUT_SECONDS=90
JOY_REMEMBER_DAYS=30
PORT=5000
